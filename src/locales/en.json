  "tourWelcomeTitle": {
    "message": "Welcome to Claude Usage Bar!"
  },
  "tourWelcomeBody": {
    "message": "A quick look at what it adds to Claude. It only takes a minute."
  },
  "tourBarTitle": {
    "message": "Usage bar"
  },
  "tourBarBody": {
    "message": "Your 5-hour plan usage, right in the composer. It fills up as you use Claude and turns orange near the limit."
  },
  "tourDetailsTitle": {
    "message": "Usage details"
  },
  "tourDetailsBody": {
    "message": "Hover the bar for the details: your pace, weekly usage, and when each limit resets."
  },
  "tourRailTitle": {
    "message": "Message navigator"
  },
  "tourRailBody": {
    "message": "In a chat, these marks on the right edge stand for your messages, and the bright one is where you are. Click any mark to jump to it."
  },
  "tourCacheTitle": {
    "message": "Cache timer"
  },
  "tourCacheBody": {
    "message": "After Claude replies, your prompt cache stays warm for a few minutes, so a follow-up costs less of your limit. The cache timer counts that down in the chat header."
  },
  "tourCacheAsk": {
    "message": "Show the cache timer?"
  },
  "tourUseIt": {
    "message": "Use it"
  },
  "tourThreadTitle": {
    "message": "Thread view"
  },
  "tourThreadBody": {
    "message": "Turns your sidebar into cards. Threads that need you come first, then finished work, then work still running. Settle a card once you're done with it."
  },
  "tourThreadAsk": {
    "message": "Use the thread view?"
  },
  "tourUseThis": {
    "message": "Use this"
  },
  "tourSettingsTitle": {
    "message": "Settings"
  },
  "tourSettingsBody": {
    "message": "This arrow opens Usage Bar's settings, where you can change any of this. Let's go there now."
  },
  "tourPacingTitle": {
    "message": "Pace estimates"
  },
  "tourPacingBody": {
    "message": "Usage Bar learns your 5-hour and weekly usage patterns to estimate your pace. Samples stay in this browser, and no prompts, responses or raw data are stored. Turn pacing off here if you'd rather not."
  },
  "tourDoneTitle": {
    "message": "All set!"
  },
  "tourDoneBody": {
    "message": "Everything else is in Settings under Usage Bar, and you can replay this tour from there under General."
  },
