  "tourWelcomeTitle": {
    "message": "Claude Usage Bar-க்கு வரவேற்கிறோம்!"
  },
  "tourWelcomeBody": {
    "message": "இது Claude-இல் என்னென்ன சேர்க்கிறது என்பதற்கான ஒரு சிறிய அறிமுகம். ஒரு நிமிடம்தான் ஆகும்."
  },
  "tourBarTitle": {
    "message": "Usage bar"
  },
  "tourBarBody": {
    "message": "உங்கள் 5-மணிநேரத் திட்டப் பயன்பாடு, செய்தி உள்ளீட்டுப் பெட்டியிலேயே. நீங்கள் Claude-ஐப் பயன்படுத்தும்போது இது நிரம்பி, வரம்பை நெருங்கும்போது ஆரஞ்சு நிறமாக மாறும்."
  },
  "tourDetailsTitle": {
    "message": "பயன்பாட்டு விவரங்கள்"
  },
  "tourDetailsBody": {
    "message": "விவரங்களைக் காண பட்டையின் மீது சுட்டியை வைக்கவும்: உங்கள் வேகக்கணிப்பு, வாராந்திரப் பயன்பாடு மற்றும் ஒவ்வொரு வரம்பும் எப்போது மீட்டமைக்கப்படும்."
  },
  "tourRailTitle": {
    "message": "செய்தி வழிகாட்டி"
  },
  "tourRailBody": {
    "message": "அரட்டையில், வலது ஓரத்தில் உள்ள இந்தக் குறிகள் உங்கள் செய்திகளைக் குறிக்கின்றன; பிரகாசமான குறி நீங்கள் இப்போது இருக்கும் இடத்தைக் காட்டும். எந்தக் குறியையும் கிளிக் செய்து அதற்குச் செல்லலாம்."
  },
  "tourCacheTitle": {
    "message": "தற்காலிக சேமிப்பு நேரங்காட்டி"
  },
  "tourCacheBody": {
    "message": "Claude பதிலளித்த பிறகு, உங்கள் தூண்டல் தற்காலிக சேமிப்பு சில நிமிடங்களுக்குச் செயலில் இருக்கும்; அதனால் தொடர் கேள்விகளுக்கு உங்கள் வரம்பிலிருந்து குறைவாகவே செலவாகும். தற்காலிக சேமிப்பு நேரங்காட்டி அரட்டைத் தலைப்பில் அந்த நேரத்தைக் கணக்கிட்டுக் காட்டும்."
  },
  "tourCacheAsk": {
    "message": "தற்காலிக சேமிப்பு நேரங்காட்டியைக் காட்டவா?"
  },
  "tourUseIt": {
    "message": "பயன்படுத்து"
  },
  "tourThreadTitle": {
    "message": "தொடர் காட்சி"
  },
  "tourThreadBody": {
    "message": "உங்கள் பக்கப்பட்டியை அட்டைகளாக மாற்றும். உங்கள் கவனம் தேவைப்படும் தொடர்கள் முதலில் வரும், அடுத்து முடிந்த வேலைகள், பிறகு செயல்பட்டுக்கொண்டிருப்பவை. ஒரு அட்டையின் வேலை முடிந்ததும் அதை ஒதுக்கிவிடலாம்."
  },
  "tourThreadAsk": {
    "message": "தொடர் காட்சியைப் பயன்படுத்தவா?"
  },
  "tourUseThis": {
    "message": "இதைப் பயன்படுத்து"
  },
  "tourSettingsTitle": {
    "message": "அமைப்புகள்"
  },
  "tourSettingsBody": {
    "message": "இந்த அம்புக்குறி Usage Bar-இன் அமைப்புகளைத் திறக்கும்; அங்கு இவற்றில் எதை வேண்டுமானாலும் மாற்றலாம். இப்போது அங்கே செல்வோம்."
  },
  "tourPacingTitle": {
    "message": "வேகக்கணிப்புகள்"
  },
  "tourPacingBody": {
    "message": "உங்கள் வேகத்தைக் கணிக்க, Usage Bar உங்கள் 5-மணிநேர மற்றும் வாராந்திரப் பயன்பாட்டு முறைகளைக் கற்றுக்கொள்கிறது. மாதிரிகள் இந்த உலாவியிலேயே இருக்கும்; தூண்டல்கள், பதில்கள் அல்லது மூலத் தரவு எதுவும் சேமிக்கப்படாது. வேண்டாமென்றால் இங்கே வேகக்கணிப்பை அணைத்துவிடலாம்."
  },
  "tourDoneTitle": {
    "message": "எல்லாம் தயார்!"
  },
  "tourDoneBody": {
    "message": "மற்ற அனைத்தும் அமைப்புகளில் Usage Bar-இன் கீழ் உள்ளன; அங்கிருந்து பொது என்பதன் கீழ் இந்த அறிமுகத்தை மீண்டும் பார்க்கலாம்."
  },
