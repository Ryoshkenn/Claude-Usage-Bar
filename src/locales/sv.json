    "message": "Visa cache-timern?"
  },
  "tourUseIt": {
    "message": "Använd den"
  },
  "tourThreadTitle": {
    "message": "Trådvy"
  },
  "tourThreadBody": {
    "message": "Gör om sidofältet till kort. Trådar som väntar på dig hamnar först, följt av klart arbete och arbete som fortfarande pågår. Lägg undan ett kort när du är klar med det."
  },
