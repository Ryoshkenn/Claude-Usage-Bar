    "message": "En snabb titt på vad tillägget ger dig i Claude. Det tar bara en minut."
  },
  "tourBarTitle": {
    "message": "Användningsmätare"
  },
  "tourBarBody": {
    "message": "Din användning under 5-timmarsgränsen, direkt i skrivrutan. Mätaren fylls på när du använder Claude och blir orange nära gränsen."
  },
  "tourDetailsTitle": {
    "message": "Användningsdetaljer"
  },
  "tourDetailsBody": {
    "message": "Håll pekaren över mätaren för detaljer: din takt, veckoanvändning och när varje gräns nollställs."
  },
  "tourRailTitle": {
    "message": "Meddelandenavigator"
  },
  "tourRailBody": {
    "message": "I en chatt motsvarar markeringarna längs högerkanten dina meddelanden, och den ljusa visar var du är. Klicka på en markering för att hoppa dit."
  },
  "tourCacheTitle": {
    "message": "Cache-timer"
  },
  "tourCacheBody": {
    "message": "När Claude har svarat hålls din prompt-cache varm i några minuter, så att en följdfråga drar mindre av din gräns. Cache-timern räknar ner tiden i chatthuvudet."
  },
