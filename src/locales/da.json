  "tourWelcomeTitle": {
    "message": "Velkommen til Claude Usage Bar!"
  },
  "tourWelcomeBody": {
    "message": "Et hurtigt kig på, hvad den føjer til Claude. Det tager kun et minut."
  },
  "tourBarTitle": {
    "message": "Usage bar"
  },
  "tourBarBody": {
    "message": "Dit 5-timers forbrug, direkte i skrivefeltet. Den fyldes op, mens du bruger Claude, og bliver orange tæt på grænsen."
  },
  "tourDetailsTitle": {
    "message": "Forbrugsdetaljer"
  },
  "tourDetailsBody": {
    "message": "Hold musen over bjælken for detaljer: dit tempo, ugentligt forbrug og hvornår hver grænse nulstilles."
  },
  "tourRailTitle": {
    "message": "Beskednavigator"
  },
  "tourRailBody": {
    "message": "I en chat står disse mærker i højre kant for dine beskeder, og det lyse viser, hvor du er. Klik på et mærke for at hoppe til det."
  },
  "tourCacheTitle": {
    "message": "Cache-timer"
  },
  "tourCacheBody": {
    "message": "Når Claude svarer, holdes din prompt-cache varm i nogle få minutter, så en opfølgning bruger mindre af din grænse. Cache-timeren tæller ned øverst i chatten."
  },
  "tourCacheAsk": {
    "message": "Vis cache-timeren?"
  },
  "tourUseIt": {
    "message": "Brug den"
  },
  "tourThreadTitle": {
    "message": "Trådvisning"
  },
  "tourThreadBody": {
    "message": "Gør din sidebjælke til kort. Tråde, der venter på dig, kommer først, derefter færdigt arbejde og til sidst arbejde, der stadig kører. Henlæg et kort, når du er færdig med det."
  },
  "tourThreadAsk": {
    "message": "Brug trådvisning?"
  },
  "tourUseThis": {
    "message": "Brug denne"
  },
  "tourSettingsTitle": {
    "message": "Indstillinger"
  },
  "tourSettingsBody": {
    "message": "Denne pil åbner indstillingerne for Usage Bar, hvor du kan ændre alt dette. Lad os gå derhen nu."
  },
  "tourPacingTitle": {
    "message": "Tempoestimater"
  },
  "tourPacingBody": {
    "message": "Usage Bar lærer dine 5-timers og ugentlige forbrugsmønstre at kende for at estimere dit tempo. Målinger bliver i denne browser, og hverken prompts, svar eller rådata gemmes. Slå tempo fra her, hvis du helst er fri."
  },
  "tourDoneTitle": {
    "message": "Alt er klart!"
  },
  "tourDoneBody": {
    "message": "Alt andet findes i Indstillinger under Usage Bar, og du kan afspille denne rundvisning igen derfra under Generelt."
  },
