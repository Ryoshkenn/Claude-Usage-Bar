  },
  "setBetaCompactDesc": {
    "message": "Когда чат превышает 250K токенов, а его кэш истёк, кнопка «Сжать» составляет запрос на итоговую сводку для продолжения в новом чате."
  },
  "compactButton": {
    "message": "Сжать"
