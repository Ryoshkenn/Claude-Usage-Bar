  "tourWelcomeTitle": {
    "message": "Claude Usage Bar ಗೆ ಸ್ವಾಗತ!"
  },
  "tourWelcomeBody": {
    "message": "ಇದು Claude ಗೆ ಏನೆಲ್ಲಾ ಸೇರಿಸುತ್ತದೆ ಎಂಬುದರ ಕಿರು ನೋಟ. ಇದಕ್ಕೆ ಕೇವಲ ಒಂದು ನಿಮಿಷ ಸಾಕು."
  },
  "tourBarTitle": {
    "message": "ಬಳಕೆಯ ಬಾರ್"
  },
  "tourBarBody": {
    "message": "ನಿಮ್ಮ 5-ಗಂಟೆಗಳ ಪ್ಲಾನ್ ಬಳಕೆ, ನೇರವಾಗಿ ಕಂಪೋಸರ್‌ನಲ್ಲಿ. ನೀವು Claude ಬಳಸಿದಂತೆ ಇದು ತುಂಬುತ್ತದೆ ಮತ್ತು ಮಿತಿಯ ಸಮೀಪ ಬಂದಾಗ ಕಿತ್ತಳೆ ಬಣ್ಣಕ್ಕೆ ತಿರುಗುತ್ತದೆ."
  },
  "tourDetailsTitle": {
    "message": "ಬಳಕೆಯ ವಿವರಗಳು"
  },
  "tourDetailsBody": {
    "message": "ವಿವರಗಳಿಗಾಗಿ ಬಾರ್ ಮೇಲೆ ಕರ್ಸರ್ ಇರಿಸಿ: ನಿಮ್ಮ ವೇಗ, ವಾರದ ಬಳಕೆ ಮತ್ತು ಪ್ರತಿಯೊಂದು ಮಿತಿ ಯಾವಾಗ ಮರುಹೊಂದಿಕೆಯಾಗುತ್ತದೆ ಎಂಬುದನ್ನು ನೋಡಿ."
  },
  "tourRailTitle": {
    "message": "ಸಂದೇಶ ನ್ಯಾವಿಗೇಟರ್"
  },
  "tourRailBody": {
    "message": "ಚಾಟ್‌ನಲ್ಲಿ, ಬಲ ಅಂಚಿನಲ್ಲಿರುವ ಈ ಗುರುತುಗಳು ನಿಮ್ಮ ಸಂದೇಶಗಳನ್ನು ಸೂಚಿಸುತ್ತವೆ ಮತ್ತು ಪ್ರಕಾಶಮಾನವಾಗಿರುವ ಗುರುತು ನೀವು ಪ್ರಸ್ತುತ ಇರುವ ಸ್ಥಳವನ್ನು ತೋರಿಸುತ್ತದೆ. ಅಲ್ಲಿಗೆ ನೇರವಾಗಿ ಹೋಗಲು ಯಾವುದೇ ಗುರುತನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ."
  },
  "tourCacheTitle": {
    "message": "ಕ್ಯಾಶ್ ಟೈಮರ್"
  },
  "tourCacheBody": {
    "message": "Claude ಪ್ರತಿಕ್ರಿಯಿಸಿದ ನಂತರ, ನಿಮ್ಮ ಪ್ರಾಂಪ್ಟ್ ಕ್ಯಾಶ್ ಕೆಲವು ನಿಮಿಷಗಳವರೆಗೆ ಸಕ್ರಿಯವಾಗಿರುತ್ತದೆ, ಆದ್ದರಿಂದ ಮುಂದಿನ ಪ್ರಶ್ನೆಗೆ ನಿಮ್ಮ ಮಿತಿಯ ಕಡಿಮೆ ಭಾಗ ಬಳಕೆಯಾಗುತ್ತದೆ. ಕ್ಯಾಶ್ ಟೈಮರ್ ಚಾಟ್ ಹೆಡರ್‌ನಲ್ಲಿ ಆ ಸಮಯವನ್ನು ಎಣಿಸುತ್ತದೆ."
  },
  "tourCacheAsk": {
    "message": "ಕ್ಯಾಶ್ ಟೈಮರ್ ತೋರಿಸಬೇಕೇ?"
  },
  "tourUseIt": {
    "message": "ಇದನ್ನು ಬಳಸಿ"
  },
  "tourThreadTitle": {
    "message": "ಥ್ರೆಡ್ ನೋಟ"
  },
  "tourThreadBody": {
    "message": "ನಿಮ್ಮ ಸೈಡ್‌ಬಾರ್ ಅನ್ನು ಕಾರ್ಡ್‌ಗಳಾಗಿ ಬದಲಾಯಿಸುತ್ತದೆ. ನಿಮ್ಮ ಗಮನ ಅಗತ್ಯವಿರುವ ಥ್ರೆಡ್‌ಗಳು ಮೊದಲು ಬರುತ್ತವೆ, ನಂತರ ಪೂರ್ಣಗೊಂಡ ಕೆಲಸಗಳು, ಆಮೇಲೆ ಇನ್ನೂ ನಡೆಯುತ್ತಿರುವ ಕೆಲಸಗಳು ಬರುತ್ತವೆ. ಕಾರ್ಡ್‌ನ ಕೆಲಸ ಮುಗಿದ ನಂತರ ಅದನ್ನು ಇತ್ಯರ್ಥಗೊಳಿಸಿ."
  },
  "tourThreadAsk": {
    "message": "ಥ್ರೆಡ್ ನೋಟವನ್ನು ಬಳಸಬೇಕೇ?"
  },
  "tourUseThis": {
    "message": "ಇದನ್ನು ಬಳಸಿ"
