  "tourWelcomeTitle": {
    "message": "Claude Usage Bar-ലേക്ക് സ്വാഗതം!"
  },
  "tourWelcomeBody": {
    "message": "ഇത് Claude-ൽ എന്തൊക്കെ ചേർക്കുന്നു എന്നതിലേക്ക് ഒരു ചെറിയ നോട്ടം. ഒരു മിനിറ്റ് മാത്രമേ എടുക്കൂ."
  },
  "tourBarTitle": {
    "message": "Usage bar"
  },
  "tourBarBody": {
    "message": "നിങ്ങളുടെ 5-മണിക്കൂർ പ്ലാൻ ഉപയോഗം കമ്പോസറിൽ തന്നെ കാണാം. നിങ്ങൾ Claude ഉപയോഗിക്കുന്നതിനനുസരിച്ച് ഇത് നിറയുകയും പരിധി അടുക്കുമ്പോൾ ഓറഞ്ച് നിറമാവുകയും ചെയ്യും."
  },
  "tourDetailsTitle": {
    "message": "ഉപയോഗ വിവരങ്ങൾ"
  },
  "tourDetailsBody": {
    "message": "കൂടുതൽ വിവരങ്ങൾക്കായി ബാറിന് മുകളിൽ കഴ്സർ വെക്കുക: നിങ്ങളുടെ വേഗത, പ്രതിവാര ഉപയോഗം, ഓരോ പരിധിയും റീസെറ്റ് ചെയ്യുന്ന സമയം എന്നിവ കാണാം."
  },
  "tourRailTitle": {
    "message": "സന്ദേശ നാവിഗേറ്റർ"
  },
  "tourRailBody": {
    "message": "ചാറ്റിൽ വലതുവശത്തുള്ള ഈ അടയാളങ്ങൾ നിങ്ങളുടെ സന്ദേശങ്ങളെ സൂചിപ്പിക്കുന്നു, തെളിഞ്ഞുനിൽക്കുന്നത് നിങ്ങൾ ഇപ്പോൾ ഉള്ള ഇടമാണ്. ഏത് അടയാളത്തിലും ക്ലിക്ക് ചെയ്ത് അതിലേക്ക് പോകാം."
  },
  "tourCacheTitle": {
    "message": "ക്യാഷ് ടൈമർ"
  },
  "tourCacheBody": {
    "message": "Claude മറുപടി നൽകിയ ശേഷം, ഏതാനും മിനിറ്റുകൾ നിങ്ങളുടെ പ്രോംപ്റ്റ് ക്യാഷ് സജീവമായി തുടരും, അതിനാൽ തുടർന്നുള്ള ചോദ്യങ്ങൾക്ക് പരിധിയിൽ നിന്ന് കുറഞ്ഞ ഉപയോഗമേ വേണ്ടിവരൂ. ക്യാഷ് ടൈമർ ചാറ്റ് ഹെഡറിൽ ആ സമയം കൗണ്ട് ഡൗൺ ചെയ്യുന്നു."
  },
  "tourCacheAsk": {
    "message": "ക്യാഷ് ടൈമർ കാണിക്കണോ?"
  },
  "tourUseIt": {
    "message": "ഇത് ഉപയോഗിക്കുക"
  },
  "tourThreadTitle": {
    "message": "ത്രെഡ് വ്യൂ"
  },
  "tourThreadBody": {
    "message": "നിങ്ങളുടെ സൈഡ്‌ബാറിനെ കാർഡുകളാക്കി മാറ്റുന്നു. നിങ്ങളുടെ ശ്രദ്ധ ആവശ്യമുള്ള ത്രെഡുകൾ ആദ്യം വരും, തുടർന്ന് പൂർത്തിയായവയും ഇപ്പോഴും പ്രവർത്തിക്കുന്നവയും. ആവശ്യം കഴിഞ്ഞാൽ കാർഡ് ഒതുക്കാം."
  },
  "tourThreadAsk": {
    "message": "ത്രെഡ് വ്യൂ ഉപയോഗിക്കണോ?"
  },
  "tourUseThis": {
    "message": "ഇത് ഉപയോഗിക്കുക"
  },
  "tourSettingsTitle": {
    "message": "ക്രമീകരണങ്ങൾ"
  },
  "tourSettingsBody": {
    "message": "ഈ ആരോ Usage Bar-ന്റെ ക്രമീകരണങ്ങൾ തുറക്കുന്നു, അവിടെ നിങ്ങൾക്ക് ഇവയെല്ലാം മാറ്റാം. നമുക്കിപ്പോൾ അങ്ങോട്ട് പോകാം."
  },
  "tourPacingTitle": {
    "message": "വേഗത കണക്കുകൂട്ടലുകൾ"
  },
  "tourPacingBody": {
    "message": "നിങ്ങളുടെ വേഗത കണക്കാക്കാൻ 5-മണിക്കൂർ, പ്രതിവാര ഉപയോഗ രീതികൾ Usage Bar മനസ്സിലാക്കുന്നു. സാമ്പിളുകൾ ഈ ബ്രൗസറിൽ തന്നെ തുടരും; പ്രോംപ്റ്റുകളോ മറുപടികളോ മറ്റ് വിവരങ്ങളോ സൂക്ഷിക്കില്ല. ഇത് താല്പര്യമില്ലെങ്കിൽ വേഗത കണക്കാക്കുന്നത് ഇവിടെ ഓഫ് ചെയ്യാം."
  },
  "tourDoneTitle": {
    "message": "എല്ലാം തയ്യാർ!"
  },
  "tourDoneBody": {
    "message": "മറ്റെല്ലാം ക്രമീകരണങ്ങളിൽ Usage Bar-ന് കീഴിലുണ്ട്, അവിടെ പൊതുവായത് എന്നതിൽ നിന്ന് നിങ്ങൾക്ക് ഈ ടൂർ വീണ്ടും കാണാവുന്നതാണ്."
  },
